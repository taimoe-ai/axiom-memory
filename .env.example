# Copy to .env for local development.
AXIOM_DATABASE_URL=postgresql://axiom:axiom@localhost:5432/axiom

# Google OAuth for interactive clients (ChatGPT / claude.ai connectors need a
# full OAuth flow). Create a "Web application" OAuth client in Google Cloud
# Console with redirect URI <base_url>/auth/callback. All three must be set
# together; leave all empty for local stdio use.
AXIOM_BASE_URL=
AXIOM_GOOGLE_CLIENT_ID=
AXIOM_GOOGLE_CLIENT_SECRET=
# Comma-separated emails allowed through Google login (required with OAuth).
AXIOM_ALLOWED_EMAILS=

# Static bearer token for headless callers (curl, CI), usable alongside OAuth.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Clients send it as:  Authorization: Bearer <token>
AXIOM_SERVICE_TOKEN=

# Gemini API key for semantic recall embeddings. Empty disables the semantic
# layer — recall degrades to lexical-only (FTS + trigram), nothing breaks.
AXIOM_GEMINI_API_KEY=

# AXIOM_HOST=127.0.0.1
# AXIOM_PORT=8080
# AXIOM_EXPORT_DIR=exports
